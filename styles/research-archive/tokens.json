{
  "name": "Research Archive",
  "version": "1.0.0",
  "description": "Warm neutrals, precise rules, technical metadata, and editorial spacing.",
  "color": {
    "light": {
      "page": "#E8E7E1",
      "paper": "#F7F6F0",
      "ink": "#292C26",
      "muted": "#5F6459",
      "faint": "#6A6F64",
      "line": "#D2D2C6",
      "lineStrong": "#A7AA9C",
      "accent": "#A94F36",
      "control": "#DEDED4"
    },
    "dark": {
      "page": "#151712",
      "paper": "#20231C",
      "ink": "#E9E9DF",
      "muted": "#B4B7AA",
      "faint": "#A2A797",
      "line": "#3C4135",
      "lineStrong": "#646B58",
      "accent": "#D98565",
      "control": "#30352A"
    }
  },
  "typography": {
    "display": { "family": "Archivo", "weight": 500, "tracking": "-0.04em" },
    "body": { "family": "IBM Plex Sans", "weight": 400, "lineHeight": 1.6 },
    "utility": { "family": "IBM Plex Mono", "weight": 500, "tracking": "0.10em", "transform": "uppercase" },
    "scalePx": { "xs": 10, "sm": 12, "md": 14, "lg": 18, "xl": 24, "display": 56 }
  },
  "spacingPx": [4, 8, 12, 16, 24, 32, 48, 64],
  "border": { "widthPx": 1, "radiusPx": 0 },
  "layout": { "contentMaxPx": 960, "readingMaxCh": 65, "mobileBreakpointPx": 640 },
  "motion": { "durationMs": 220, "easing": "cubic-bezier(0.32, 0.72, 0, 1)" },
  "contrast": {
    "lightMinimum": 4.76,
    "darkMinimum": 5.68,
    "basis": "Core text and accent colors against paper"
  }
}
